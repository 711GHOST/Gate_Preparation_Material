# ---- S3 storage (optional) --------------------------------------------------
# When these are set, resource downloads are served via short-lived presigned
# URLs from your bucket. When unset, the site falls back to the files bundled
# in /public/resources (so it works out of the box).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=your-bucket-name
# Optional key prefix inside the bucket, e.g. "gate2027". Leave blank for root.
S3_PREFIX=

# ---- Public site (recommended for SEO / canonical URLs) -----------------------
NEXT_PUBLIC_SITE_URL=https://gate-prep-five.vercel.app
# Optional: overrides the published founder email used by contact & feedback links
NEXT_PUBLIC_CONTACT_EMAIL=
